<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PersonalFinance.Maui.Views"
       x:Class="PersonalFinance.Maui.AppShell"
       Title="Personal Finance">

    <FlyoutItem Title="Login" Route="login" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Dashboard" Route="dashboard">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Contas" Route="accounts">
        <ShellContent ContentTemplate="{DataTemplate views:AccountsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Transações" Route="transactions">
        <ShellContent ContentTemplate="{DataTemplate views:TransactionsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Categorias" Route="categories">
        <ShellContent ContentTemplate="{DataTemplate views:CategoriesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Orçamentos" Route="budgets">
        <ShellContent ContentTemplate="{DataTemplate views:BudgetsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Metas" Route="goals">
        <ShellContent ContentTemplate="{DataTemplate views:GoalsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Cartões de Crédito" Route="creditcards">
        <ShellContent ContentTemplate="{DataTemplate views:CreditCardsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Recorrentes" Route="recurring">
        <ShellContent ContentTemplate="{DataTemplate views:RecurringTransactionsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Relatórios" Route="reports">
        <ShellContent ContentTemplate="{DataTemplate views:ReportsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Configurações" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

</Shell>
