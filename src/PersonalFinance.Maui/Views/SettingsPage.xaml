<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalFinance.Maui.Views.SettingsPage"
             Title="Configurações">
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="8">
            <Label Text="Configurações" Style="{StaticResource TitleLabel}"/>

            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Aparência" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <Picker ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"/>
                    <Label Text="Idioma" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <Label Text="{Binding Language}"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Sincronização" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <Label Text="{Binding LastSyncStatus}" FontSize="12"/>
                    <Label Text="{Binding AppVersion, StringFormat='Versão: {0}'}" FontSize="12" TextColor="{StaticResource Gray500}"/>
                    <Button Text="Sincronizar agora" Command="{Binding SyncNowCommand}" IsEnabled="{Binding IsNotBusy}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}"/>

            <Button Text="Sair" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" IsEnabled="{Binding IsNotBusy}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
