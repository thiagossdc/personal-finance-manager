<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalFinance.Maui.Views.LoginPage"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Padding="24" Spacing="8">
            <Label Text="Personal Finance Manager" Style="{StaticResource TitleLabel}" HorizontalOptions="Center"/>
            <Label Text="Gerenciamento financeiro pessoal offline-first" HorizontalOptions="Center" Margin="0,0,0,24"/>

            <Label Text="E-mail"/>
            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="seu@email.com"/>

            <Label Text="Senha" IsVisible="True"/>
            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Senha"/>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}"/>

            <Button Text="Entrar" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}"/>
            <Button Text="Criar conta" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource DangerButton}"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
